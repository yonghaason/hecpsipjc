#pragma once


// compile the library with GMW
#cmakedefine VOLE_PSI_ENABLE_GMW @VOLE_PSI_ENABLE_GMW@ 

// compile the library with circuit psi
#cmakedefine VOLE_PSI_ENABLE_CPSI @VOLE_PSI_ENABLE_CPSI@ 

// enable Microsoft SEAL BGV postprocessing
#cmakedefine VOLE_PSI_ENABLE_SEAL @VOLE_PSI_ENABLE_SEAL@


// compile the library with OPPRF
#cmakedefine VOLE_PSI_ENABLE_OPPRF @VOLE_PSI_ENABLE_OPPRF@ 
